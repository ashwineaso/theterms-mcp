{
  "name": "@theterms/mcp",
  "version": "0.0.0",
  "type": "module",
  "description": "MCP server for TheTerms — expose the TheTerms REST API as tools for AI agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashwineaso/theterms-mcp"
  },
  "author": "TheTerms",
  "bin": {
    "theterms-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
